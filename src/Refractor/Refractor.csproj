<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The Android target needs the .NET Android workload, so it is only built when asked for, as the package build does. -->
		<TargetFrameworks>net8.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(RefractorAndroid)' == 'true'">net8.0;net10.0-android</TargetFrameworks>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<RefractorAndroidLibrary>$(RefractorNativeRoot)/android/prism.aar</RefractorAndroidLibrary>
		<RootNamespace>Refractor</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Refractor</PackageId>
		<Description>Speech, braille and screen reader output for .NET through prism: NVDA, JAWS, SAPI, OneCore, VoiceOver, Speech Dispatcher, Orca and more behind one API. Links statically into Native AOT executables.</Description>
		<PackageTags>accessibility;screen-reader;tts;speech;braille;nvda;jaws;sapi;voiceover;speech-dispatcher;orca;prism;native-aot</PackageTags>
		<PackageLicenseExpression>MIT AND MPL-2.0 AND Apache-2.0 AND BSD-2-Clause AND Zlib</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/trypsynth/refractor</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RefractorPackRuntimes>win-x64;win-arm64;win-x86;osx-arm64;osx-x64;ios-arm64;iossimulator-arm64;iossimulator-x64;linux-x64;linux-arm64</RefractorPackRuntimes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../README.md;../../LICENSE;../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
		<None Include="../../native/prism/LICENSES/**/*" Pack="true" PackagePath="licenses/prism/%(RecursiveDir)" />
		<None Include="build/Refractor.targets" Pack="true" PackagePath="buildTransitive/" />
	</ItemGroup>

	<!-- prism's archive carries its Java backends, its libprism.so for each ABI, and the manifest entry that gives it the application context. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidLibrary Include="$(RefractorAndroidLibrary)" Bind="false" />
		<AndroidJavaSource Include="Android/PrismLoader.java" Bind="false" />
	</ItemGroup>

	<Target Name="_RefractorCheckAndroidLibrary" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and !Exists('$(RefractorAndroidLibrary)')">
		<Error Text="prism is not built for Android. Run scripts/build-native.ps1 -Runtimes android first." />
	</Target>

	<Target Name="_RefractorPackNative" BeforeTargets="_GetPackageFiles">
		<Error Condition="'$(RefractorAndroid)' != 'true'" Text="The package includes Android, so pack with -p:RefractorAndroid=true and the .NET Android workload installed." />
		<ItemGroup>
			<_RefractorPackRuntime Include="$(RefractorPackRuntimes)" />
			<_RefractorMissing Include="@(_RefractorPackRuntime)" Condition="!Exists('$(RefractorNativeRoot)/%(Identity)/static/lib/Refractor.Native.targets') or (!Exists('$(RefractorNativeRoot)/%(Identity)/shared/bin/prism.dll') and !Exists('$(RefractorNativeRoot)/%(Identity)/shared/lib/libprism.dylib') and !Exists('$(RefractorNativeRoot)/%(Identity)/shared/lib/libprism.so') and !$([System.String]::Copy('%(Identity)').StartsWith('ios')))" />
		</ItemGroup>
		<Error Condition="'@(_RefractorMissing)' != ''" Text="prism is not built for @(_RefractorMissing). Run scripts/build-native.ps1 first." />
		<ItemGroup>
			<None Include="$(RefractorNativeRoot)/%(_RefractorPackRuntime.Identity)/shared/bin/*.dll;$(RefractorNativeRoot)/%(_RefractorPackRuntime.Identity)/shared/lib/*.dylib;$(RefractorNativeRoot)/%(_RefractorPackRuntime.Identity)/shared/lib/*.so" Pack="true" PackagePath="runtimes/%(_RefractorPackRuntime.Identity)/native/" />
			<None Include="$(RefractorNativeRoot)/%(_RefractorPackRuntime.Identity)/static/lib/*.lib;$(RefractorNativeRoot)/%(_RefractorPackRuntime.Identity)/static/lib/*.a;$(RefractorNativeRoot)/%(_RefractorPackRuntime.Identity)/static/lib/Refractor.Native.targets" Pack="true" PackagePath="native/%(_RefractorPackRuntime.Identity)/" />
		</ItemGroup>
	</Target>

</Project>
