<Project>

	<!-- Native AOT links prism into the executable, so nothing ships beside it. Everything else loads the shared prism from the package's runtimes folder. -->
	<PropertyGroup>
		<RefractorStaticLink Condition="'$(RefractorStaticLink)' == '' and '$(PublishAot)' == 'true'">true</RefractorStaticLink>
		<!-- An iOS app cannot load a library of its own, so prism is always linked into it. -->
		<RefractorStaticLink Condition="'$(RefractorStaticLink)' == '' and $(RuntimeIdentifier.StartsWith('ios'))">true</RefractorStaticLink>
		<RefractorNativeDirectory Condition="'$(RefractorNativeDirectory)' == ''">$(MSBuildThisFileDirectory)../native/$(RuntimeIdentifier)/</RefractorNativeDirectory>
		<_RefractorLinkTargets>$(RefractorNativeDirectory)Refractor.Native.targets</_RefractorLinkTargets>
	</PropertyGroup>

	<ItemGroup Condition="'$(RefractorStaticLink)' == 'true'">
		<DirectPInvoke Include="prism" />
	</ItemGroup>

	<Import Project="$(_RefractorLinkTargets)" Condition="'$(RefractorStaticLink)' == 'true' and Exists('$(_RefractorLinkTargets)')" />

	<Target Name="_RefractorCheckStaticLink" BeforeTargets="PrepareForPublish" Condition="'$(RefractorStaticLink)' == 'true' and !Exists('$(_RefractorLinkTargets)')">
		<Error Text="Refractor has no static prism for '$(RuntimeIdentifier)'. Set RefractorStaticLink to false to ship the shared prism beside the executable instead." />
	</Target>

	<Target Name="_RefractorDropSharedLibrary" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RefractorStaticLink)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'prism.dll' or '%(Filename)%(Extension)' == 'libprism.dylib' or '%(Filename)%(Extension)' == 'libprism.so'" />
		</ItemGroup>
	</Target>

</Project>
