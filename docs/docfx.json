{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Refractor",
          "files": ["Refractor.csproj"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Refractor",
      "_appTitle": "Refractor",
      "_appFooter": "Refractor is MIT licensed. The prism library it wraps is under the Mozilla Public License 2.0.",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/trypsynth/refractor",
        "branch": "master"
      }
    },
    "sitemap": {
      "baseUrl": "https://trypsynth.github.io/refractor"
    }
  }
}
