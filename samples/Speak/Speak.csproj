<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
		<PublishAot>true</PublishAot>
		<IsPackable>false</IsPackable>
		<RefractorNativeDirectory>$(RefractorNativeRoot)/$(RuntimeIdentifier)/static/lib/</RefractorNativeDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Refractor\Refractor.csproj" />
	</ItemGroup>

	<!-- A package reference brings these in on its own. A project reference has to ask. -->
	<Import Project="..\..\src\Refractor\build\Refractor.targets" />

	<ItemGroup>
		<None Include="$(RefractorNativeRoot)/$(RuntimeIdentifier)/shared/bin/*.dll;$(RefractorNativeRoot)/$(RuntimeIdentifier)/shared/lib/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
