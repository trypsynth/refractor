<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<ApplicationId>com.trypsynth.refractor.speak</ApplicationId>
		<ApplicationTitle>Refractor</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Refractor\Refractor.csproj" />
	</ItemGroup>

	<!-- Restore has to see the Android target in Refractor too, which only a global property reaches. -->
	<Target Name="_RefractorRequireAndroid" BeforeTargets="CollectPackageReferences;PrepareForBuild" Condition="'$(RefractorAndroid)' != 'true'">
		<Error Text="Build this sample with -p:RefractorAndroid=true." />
	</Target>

	<!-- A package reference brings these in on its own. A project reference has to ask. -->
	<Import Project="..\..\src\Refractor\build\Refractor.targets" />

</Project>
